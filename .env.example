# Admin Panel
ADMIN_PASSWORD="replace-with-a-strong-admin-password"

# Vercel Blob Storage
BLOB_READ_WRITE_TOKEN="replace-with-your-vercel-blob-token"

# Gmail SMTP — use a Google App Password, never your normal Gmail password.
# Create one at: https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="zardosiatelier@gmail.com"
SMTP_PASS="replace-with-your-16-character-google-app-password"

# Contact-form delivery
MAIL_FROM_EMAIL="zardosiatelier@gmail.com"
MAIL_FROM_NAME="Zardosi Atelier"
BUSINESS_INBOX="zardosiatelier@gmail.com"
NOTIFICATION_EMAIL="zardosiatelier@gmail.com"
REPLY_INBOX="zardosiatelier@gmail.com"
WEBSITE_URL="https://www.zardosiatelier.com"

# Optional: enable Google reCAPTCHA v3 verification in production.
RECAPTCHA_SECRET_KEY=""

# Em Dash CMS (server-only; never expose these through VITE_ variables)
CMS_ORIGIN="https://cms.zardosiatelier.com"
CMS_READ_TOKEN="replace-with-an-emdash-subscriber-token"
CMS_PREVIEW_READ_TOKEN="replace-with-a-read-only-draft-capable-token"
REVALIDATE_HMAC_SECRET="replace-with-the-same-32-byte-secret-used-by-the-cms-worker"
PREVIEW_HANDOFF_SECRET="replace-with-the-same-independent-32-byte-secret-used-by-the-cms-worker"
